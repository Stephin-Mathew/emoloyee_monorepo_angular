{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "data",
  "sourceRoot": "packages/data/src",
  "projectType": "library",
  "tags": ["scope:employee-management", "type:data"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/packages/data"],
      "options": {
        "project": "packages/data/ng-package.json",
        "tsConfig": "packages/data/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/data/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    }
  }
}
