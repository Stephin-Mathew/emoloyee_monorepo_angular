{
  "name": "shared",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/employee-management/shared/src",
  "prefix": "lib",
  "tags": ["scope:shared", "type:ui"],
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/employee-management/shared/ng-package.json",
        "tsConfig": "packages/employee-management/shared/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/employee-management/shared/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    }
  }
}
